# =========================
# Unity specific ignores
# =========================

# Unity generated folders
Library/
Temp/
Obj/
Build/
Builds/
Logs/
UserSettings/

# Asset Store / Collaborate / Packages caches
Assets/AssetStoreTools*
[Aa]ssets/Plugins/Editor/JetBrains*

# Auto-generated VS/IDE project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Rider / JetBrains
.idea/
*.sln.iml

# Visual Studio
.vs/

# VS Code
.vscode/

# Crash and log files
*.stacktrace
*.log

# Build artefacts (extra safety)
[Bb]uild/
[Bb]uilds/

# =========================
# OS / Tooling junk
# =========================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Python cache (kept from old file)
*.pyc
__pycache__/

